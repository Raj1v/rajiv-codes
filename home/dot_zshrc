# tmux command log: one JSON line per finished command → ~/.tmux-logs/commands.jsonl
if [[ -n $TMUX ]] && (( $+commands[jq] )); then
  zmodload zsh/datetime
  _tl_file=~/.tmux-logs/commands.jsonl
  mkdir -p ${_tl_file:h}

  _tl_preexec() { _tl_cmd=$1 _tl_cwd=$PWD _tl_start=$EPOCHREALTIME }
  _tl_precmd() {
    local exit=$?
    [[ -z $_tl_cmd ]] && return
    local -a t=("${(@f)$(tmux display -p -t "$TMUX_PANE" $'#S\n#I\n#W\n#P')}")
    jq -nc \
      --arg session "$t[1]" --argjson window "$t[2]" --arg window_name "$t[3]" --argjson pane "$t[4]" \
      --arg cwd "$_tl_cwd" --arg cmd "$_tl_cmd" \
      --argjson start "$_tl_start" --argjson end "$EPOCHREALTIME" --argjson exit "$exit" \
      '{ts: ($start|todate), session:$session, window:$window, window_name:$window_name, pane:$pane,
        cwd:$cwd, cmd:$cmd, exit:$exit, duration_s: (($end-$start)*1000|round/1000)}' >> $_tl_file
    unset _tl_cmd
  }
  autoload -Uz add-zsh-hook
  add-zsh-hook precmd _tl_precmd
  add-zsh-hook preexec _tl_preexec
fi

