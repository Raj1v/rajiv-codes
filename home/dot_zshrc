# `wm` is workmux, except `wm add`, which detaches. Worktree creation and post-create
# hooks are slow, so this frees the calling shell (and any popup) straight away.
# Output goes to a log; tmux shows a message on finish, since the foreground output is lost.
wm() {
  if [[ $1 != add ]]; then
    command workmux "$@"
    return
  fi
  shift
  local log=${XDG_CACHE_HOME:-$HOME/.cache}/workmux/add-$(date +%Y%m%d-%H%M%S).log
  mkdir -p ${log:h}
  nohup zsh -c "workmux add -b ${(j: :)${(q)@}} >| ${(q)log} 2>&1;
    tmux display-message \"wm add: \$([[ \$? -eq 0 ]] && print done || print FAILED, see ${(q)log})\"" >/dev/null 2>&1 &!
  print "backgrounded -> $log"
}
