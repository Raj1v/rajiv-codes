# Pick a PR with fzf, open it as a workmux worktree.
# Defaults to your own PRs (--me). Pass --all to include everyone's.
wmpr() {
  local author="@me"
  local -a passthrough
  while (( $# )); do
    case $1 in
      --me)  author="@me"; shift ;;
      --all) author=""; shift ;;
      *)     passthrough+=("$1"); shift ;;
    esac
  done

  local -a gh_args=(--limit 50 --json number,title,author,headRefName)
  [[ -n $author ]] && gh_args+=(--author "$author")

  local pr
  pr=$(gh pr list "${gh_args[@]}" \
        --template '{{range .}}{{printf "%-6v" .number}}  {{.headRefName | printf "%-40.40s"}}  {{.author.login | printf "%-15.15s"}}  {{.title}}{{"\n"}}{{end}}' \
      | fzf --prompt="PR (${author:-all}) > " --height 60% --reverse \
      | awk '{print $1}')
  [[ -n $pr ]] && workmux add --pr "$pr" "${passthrough[@]}"
}

# Pick any remote branch with fzf, open it as a workmux worktree
wmrb() {
  local ref
  git fetch --quiet --all
  ref=$(git for-each-ref --sort=-committerdate \
          --format='%(refname:short)  %(committerdate:relative)  %(authorname)' \
          refs/remotes \
      | grep -v '/HEAD' \
      | fzf --prompt='branch > ' --height 60% --reverse \
      | awk '{print $1}')
  [[ -n $ref ]] && workmux add "$ref" "$@"
}

