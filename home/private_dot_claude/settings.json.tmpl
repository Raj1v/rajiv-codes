{{- $mac := eq .chezmoi.os "darwin" -}}
{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "defaultMode": "auto"
  },
  "model": "{{ if $mac }}opus[1m]{{ else }}opus{{ end }}",
  "hooks": {
{{- if not $mac }}
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/scripts/gh-inbox-session-start.sh"
          }
        ]
      }
    ],
{{- end }}
    "Notification": [
      {
        "matcher": "permission_prompt|elicitation_dialog",
        "hooks": [
          {
            "type": "command",
            "command": "workmux set-window-status waiting"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "workmux set-window-status working"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "workmux set-window-status done"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "workmux set-window-status working"
          }
        ]
      }
    ]{{ if not $mac }},
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "jot unsubscribe-all 2>/dev/null || true"
          }
        ]
      }
    ]{{ end }}
  },
  "statusLine": {
    "type": "command",
    "command": "node \"{{ .chezmoi.homeDir }}/.claude/hooks/statusline.js\""
  },
  "enabledPlugins": {
    "recall@recall-marketplace": true,
    "figma@claude-plugins-official": true,
    "posthog@claude-plugins-official": true,
    "supabase@claude-plugins-official": true,
    "ponytail@ponytail": true,
    "studyflash-traces@studyflash": true,
    "slack@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    },
    "studyflash": {
      "source": {
        "source": "github",
        "repo": "studyflash-ai/studyflash"
      }
    }
  },
  "effortLevel": "{{ if $mac }}low{{ else }}medium{{ end }}",
{{- if $mac }}
  "fastMode": true,
{{- end }}
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "auto",
  "switchModelsOnFlag": false,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "voiceEnabled": true,
  "env": {
{{- if not $mac }}
    "PLANNOTATOR_REMOTE": "1",
    "PLANNOTATOR_URL_HOST": "100.105.175.39",
{{- end }}
    "CLAUDE_CODE_SHELL": "{{ if eq .chezmoi.os "darwin" }}/opt/homebrew/bin/bash{{ else }}/home/linuxbrew/.linuxbrew/bin/bash{{ end }}"
  }
}
